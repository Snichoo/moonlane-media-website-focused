# Resend transactional email (contact forms). Copy to .env.local and fill in.
RESEND_API_KEY=

# Where contact-form submissions are delivered.
CONTACT_TO_EMAIL=contact@moonlanemedia.com

# "From" address — must be on a domain verified at resend.com/domains.
# Avoid Resend's shared onboarding@resend.dev even for testing: it is restricted
# without notice and fails *after* the API returns success, so breakage is silent.
CONTACT_FROM_EMAIL=Moonlane Media <contact@moonlanemedia.com.au>

# ---------------------------------------------------------------------------
# Google Ads conversion tracking
#
# The base tag in app/layout.tsx only reports page views. Each conversion
# action needs its own label or nothing is recorded. Find them in Google Ads →
# Goals → Conversions → (action) → Tag setup → "Install the tag yourself": the
# snippet reads send_to: 'AW-18359320430/AbCdEfGh12345' — the part AFTER the
# slash is the label. These are NEXT_PUBLIC_* (inlined into the browser bundle
# at build time), so a change requires a rebuild/redeploy.
# ---------------------------------------------------------------------------

# Optional — defaults to the AW- id hard-coded in app/layout.tsx.
NEXT_PUBLIC_GADS_ID=AW-18359320430

# Fired when a contact form is successfully delivered. Blank — the live label
# is the default in src/lib/gtag.ts; set this only to override it.
NEXT_PUBLIC_GADS_LABEL_FORM_SUBMIT=

# Fired when a tel: link is clicked. Leave blank to skip this conversion.
NEXT_PUBLIC_GADS_LABEL_PHONE_CLICK=

# Fired when a mailto: link is clicked. Leave blank to skip this conversion.
NEXT_PUBLIC_GADS_LABEL_EMAIL_CLICK=

# "Calls from website visits" conversion label. When configured, Google swaps
# 0414 134 081 for a forwarding number after an eligible ad click and reports
# the connected call rather than merely a tel: click.
NEXT_PUBLIC_GADS_LABEL_WEBSITE_CALL=

# ---------------------------------------------------------------------------
# Meta Lead Ads webhook  (/api/webhooks/meta-leads)
#
# Forwards every Meta instant-form lead to email as it arrives. All four are
# required — the route refuses to run unverified. Set them in Vercel, not here.
#
# Meta-side setup (developers.facebook.com -> your app):
#   1. Add the "Webhooks" product, subscribe the Page to the `leadgen` field.
#   2. Callback URL: https://moonlanemedia.com.au/api/webhooks/meta-leads
#      Verify token: whatever you set in META_VERIFY_TOKEN below.
#   3. Generate a long-lived Page access token with the `leads_retrieval` and
#      `pages_show_list` permissions, and paste it into META_PAGE_ACCESS_TOKEN.
# ---------------------------------------------------------------------------

# Any random string you invent. Must match the "Verify token" typed into Meta.
META_VERIFY_TOKEN=

# App secret from Meta -> App settings -> Basic. Used to verify the signature
# on every delivery; without it forged leads could be injected.
META_APP_SECRET=

# Long-lived Page access token. The webhook only carries a leadgen_id, so the
# answers have to be fetched from the Graph API with this.
META_PAGE_ACCESS_TOKEN=

# Where Meta leads are delivered. Falls back to CONTACT_TO_EMAIL.
META_LEADS_TO_EMAIL=sam@moonlanemedia.com

# Optional. Blank uses the app's default Graph version, which survives Meta's
# quarterly deprecations. Set e.g. v23.0 only to pin a specific version.
META_GRAPH_VERSION=
